{
  "name": "secure-evoting-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.15.0" },
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --mode local-demo",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:voting-browser": "playwright test --config playwright.voting.config.ts",
    "test:admin-browser": "playwright test --config playwright.admin.config.ts",
    "test:tally-browser": "playwright test --config playwright.tally.config.ts"
  },
  "dependencies": {
    "@cloudflare/blindrsa-ts": "0.4.6",
    "canonicalize": "5.1.0",
    "lucide-react": "1.73.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router": "8.5.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.10",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
